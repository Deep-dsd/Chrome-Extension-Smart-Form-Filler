{
  "manifest_version": 3,
  "name": "Simple Form Filler",
  "version": "1.0.0",
  "description": "Right-click to fill forms with test data",
  "permissions": ["contextMenus", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
