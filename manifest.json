{
  "manifest_version": 3,
  "name": "Smart Form Filler",
  "version": "1.0.0",
  "description": "Auto-fill web forms with realistic test data via right-click context menu",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/utils/constants.js",
        "src/utils/fieldClassifier.js",
        "src/utils/dataGenerator.js",
        "src/content/formDetector.js",
        "src/content/formFiller.js",
        "src/content/content.js"
      ],
      "css": []
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
